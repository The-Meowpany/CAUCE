# Central configuration. Copy to .env and fill in. Never commit the filled copy.
#
# The backend reads these once, at import, from the environment. There is no config file
# and no .env loader: docker compose reads .env itself, and a bare run needs them exported.

# REQUIRED IN PRACTICE. With this empty every write answers 503
# admin_api_not_configured rather than being allowed, because there is no credential to
# check. Reads stay open so the dashboard works on a trusted LAN. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CAUCE_API_TOKEN=

# Shared secret for node batch upload. Separate from the admin token on purpose: this one
# goes into every node's flash, so a node that is lost or cloned must not hand over admin.
# Empty means unauthenticated ingest, which is only defensible on a trusted LAN.
CAUCE_SYNC_TOKEN=

# Refuse unsigned node batches outright instead of accepting them. The central answers 503
# rather than guessing when a node was never provisioned and this is on.
CAUCE_SYNC_REQUIRE_AUTH=1

# Requests per minute per client for the write endpoints.
CAUCE_RATE_LIMIT=120

# SQLite path. The directory has to exist before the first connection.
CAUCE_DB_PATH=./data/cauce.sqlite

# Only enable behind a reverse proxy you control, or a client can forge X-Forwarded-For
# and walk straight past the rate limiter.
CAUCE_TRUST_PROXY=

# Retention. Raw rows older than the window are gone; take a backup first if the history
# matters.
CAUCE_RETENTION_ENABLED=1
CAUCE_RETENTION_DAYS=365
CAUCE_RETENTION_INTERVAL_H=24
CAUCE_VACUUM_INTERVAL_H=24

# Optional: alert delivery and OTA release feed. Empty disables each.
CAUCE_TELEGRAM_BOT_TOKEN=
CAUCE_OTA_RELEASES=

# Default UI language for the scripts and the simulator: en or anything else for es.
CAUCE_LANG=es

# NOT a server setting: where the node finds its MinGW-w64 g++ for the host builds.
# Only read by scripts/verify-all.ps1 and scripts/run-e2e.ps1.
CAUCE_MINGW_BIN=
